[
  {"init": "Math.random = () => 1 / 2 ** 31;"},
  {"click": ".playNext button"},
  {"click": ".patchList .habBtn"},
  {"click": ".patchWrap .liveBtn"},
  {"click": ".equip .go"},
  {"click": "#cardButtons button"},
  {"eval": "__game.life.turn = 20; __game.life.build.size = 3; __game.life.food = 100; document.querySelector('#lay').disabled = false; document.querySelector('#lay').click();"},
  {"until": "!__game.busy && !document.querySelector('#cardWrap').hidden"},
  {"click": "#cardButtons button"},
  {"assert": "!!document.querySelector('.placement') && !document.querySelector('.patchWrap') && !document.querySelector('.playNext') && __game.save.lives === 0"},
  {"assert": "document.querySelectorAll('.choices button').length === 1 + __game.save.sea.patches[__game.save.pending.patch].nb.length"},
  {"shot": "21c-placing"},
  {"reload": true},
  {"until": "!!document.querySelector('.placement')"},
  {"assert": "__game.save.pending.place === undefined && __game.save.lives === 0"},
  {"click": ".choices button:nth-child(2)"},
  {"assert": "document.querySelector('.placeInfo').textContent.includes('new ground: 50% strength')"},
  {"shot": "21c-placing-neighbour"},
  {"click": ".placement .go"},
  {"until": "!!document.querySelector('.after .egg')"},
  {"assert": "__game.save.pending.place === __game.save.sea.patches[__game.save.pending.patch].nb[0]"},
  {"reload": true},
  {"until": "!!document.querySelector('.after .egg')"},
  {"assert": "!document.querySelector('.placement') && __game.save.lives === 0"},
  {"click": ".after button:has-text('Keep none')"},
  {"assert": "__game.save.pending === undefined && __game.save.lives === 1 && __game.save.continuation.patch === __game.save.sea.patches[0].nb[0]"},
  {"click": ".gain .go"},
  {"until": "!!document.querySelector(\".spread\")"},
  {"click": ".isle"},
  {"assert": "!document.querySelector(\".spread\") && !!document.querySelector(\".playNext\") && __game.save.sea.gen === 2"},
  {"reload": true},
  {"assert": "__game.save.pending === undefined && __game.save.lives === 1"}
]
