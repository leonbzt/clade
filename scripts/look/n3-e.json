[
  {"until": "!!window.__clade"},
  {"eval": "(()=>{const c=window.__clade;c.setPreset('first-worm');c.pick('root-worm');const t=c.world.habitats.find(h=>{c.select(h.id);return c.colonise()});return {launched:!!t}})()"},
  {"until": "!!window.__game && !window.__game.busy"},
  {"click": "button:has-text('+10 food')"},
  {"until": "!window.__game.busy"},
  {"click": "#grow"},
  {"until": "!window.__game.busy"},
  {"click": "#wait"},
  {"until": "!window.__game.busy"},
  {"click": "#grow"},
  {"until": "!window.__game.busy"},
  {"eval": "window.__game.mutate('tentacles')"},
  {"until": "!window.__game.busy"},
  {"click": "#lay"},
  {"until": "!window.__game.busy"},
  {"click": "button:has-text('End the season')"},
  {"until": "!!window.__clade.clutch && !!document.querySelector('.hatch')"},
  {"assert": "window.__clade.clutch.offers.length===2 && window.__clade.clutch.offers[0].card.part==='tentacles' && !window.__clade.session.report"},
  {"assert": "document.querySelectorAll('.egg .shell').length===2 && document.querySelector('.go').disabled"},
  {"wait": 300},
  {"shot": "n3-e-closed"},
  {"click": ".egg >> nth=0"},
  {"click": ".egg >> nth=1"},
  {"click": ".egg >> nth=0"},
  {"assert": "document.querySelectorAll('.egg .shell').length===0 && document.querySelector('.egg.chosen .face').textContent.includes('Tentacles') && !document.querySelector('.go').disabled"},
  {"assert": "(()=>{const r=document.querySelector('.hatch').getBoundingClientRect();return r.left>=0&&r.right<=innerWidth&&r.top>=0&&r.bottom<=innerHeight})()"},
  {"shot": "n3-e-open"},
  {"click": "button:has-text('Hatch this one')"},
  {"until": "!!window.__clade.session.report"},
  {"wait": 2000},
  {"assert": "document.querySelector('.heir').textContent==='Tentacles worm hatches' && window.__clade.world.lineages[0].xp===window.__clade.session.gain.to && window.__clade.session.gain.to>0"},
  {"assert": "(()=>{const r=document.querySelector('.hatch').getBoundingClientRect();return r.left>=0&&r.right<=innerWidth&&r.top>=0&&r.bottom<=innerHeight})()"},
  {"shot": "n3-e-gain"},
  {"click": "button:has-text('Back to the map')"},
  {"until": "!window.__game && !window.__clade.clutch"},
  {"assert": "(()=>{const w=window.__clade.world,c=w.species.find(s=>s.parent==='root-worm');return c&&c.build.parts.front==='tentacles'&&Object.values(w.habitats.find(h=>h.id===window.__clade.world.habitats.find(x=>x.pops[c.id])?.id)?.pops??{}).length>0})()"},
  {"shot": "n3-e-map"}
]
