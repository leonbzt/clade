[
  {"until": "!!window.__clade"},
  {"eval": "(async()=>{const c=window.__clade;c.setPreset('first-worm');const {colonise}=await import('/clade/src/sim/found.ts');const parent=c.world.species.find(s=>s.id==='root-worm');const target=c.world.habitats.find(h=>colonise(c.world,h,parent));c.pick(parent.id);c.select(target.id);return {launched:c.colonise()}})()"},
  {"until": "!!window.__game && !window.__game.busy"},
  {"click": "button:has-text('+10 food')"},
  {"until": "!window.__game.busy"},
  {"click": "#grow"},
  {"until": "!window.__game.busy"},
  {"click": "#wait"},
  {"until": "!window.__game.busy"},
  {"click": "#grow"},
  {"until": "!window.__game.busy"},
  {"assert": "window.__game.life.mutationOffer.includes('tentacles')"},
  {"eval": "window.__game.mutate('tentacles')"},
  {"until": "!window.__game.busy"},
  {"click": "#enforce button"},
  {"until": "!window.__game.busy"},
  {"assert": "window.__game.life.enforced.tentacles===1"},
  {"click": "#lay"},
  {"until": "!window.__game.busy"},
  {"assert": "window.__game.life.eggs===3 && window.__game.life.eggsAfter===3"},
  {"click": "button:has-text('End the season')"},
  {"until": "!!window.__clade.session.report"},
  {"eval": "(async()=>{const c=window.__clade,l=window.__game.life;const {resultOf}=await import('/clade/src/sim/economy.ts');const {rollClutch,heirBuild,clutchWeight}=await import('/clade/src/sim/clutch.ts');const result=resultOf(l),parent=c.session.species,before=JSON.stringify({result,parent,world:c.world});const cards=rollClutch(result,parent,l.seed),heir=heirBuild(parent.build,cards[0]);window.__n3c={cards,repeat:JSON.stringify(cards)===JSON.stringify(rollClutch(result,parent,l.seed)),large:rollClutch({...result,eggs:10},parent,l.seed).length,zero:rollClutch({...result,eggs:0},parent,l.seed).length,heir:heir.parts,feedWeight:clutchWeight(result.enforced,'bulb'),unchanged:before===JSON.stringify({result,parent,world:c.world})};return window.__n3c})()"},
  {"assert": "window.__n3c.cards.length===2 && window.__n3c.cards[0].kind==='gain' && window.__n3c.cards[0].part==='tentacles' && window.__n3c.cards[0].place==='front'"},
  {"assert": "window.__n3c.repeat && window.__n3c.large===3 && window.__n3c.zero===0 && window.__n3c.heir.front==='tentacles' && window.__n3c.feedWeight===2 && window.__n3c.unchanged"},
  {"shot": "n3-c-result"},
  {"click": "button:has-text('Back to the map')"},
  {"until": "!window.__game"},
  {"assert": "Object.keys(window.__clade.world.species.find(s=>s.id==='root-worm').build.parts).length===0"}
]
