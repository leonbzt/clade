[
 {
  "until": "!!window.__clade"
 },
 {
  "eval": "window.__clade.setPreset('midgame')"
 },
 {
  "wait": 300
 },
 {
  "assert": "document.querySelector('button.line').textContent.includes('level 2')"
 },
 {
  "click": "button.line"
 },
 {
  "wait": 300
 },
 {
  "assert": "!!document.querySelector('.line[role=dialog]') && document.querySelector('.line h2').textContent==='Worm line \u00b7 level 2'"
 },
 {
  "eval": "({tree:[...document.querySelectorAll('.tree li > b')].map(b=>b.textContent), parts:[...document.querySelectorAll('.part')].map(p=>p.textContent.replace(/\\s+/g,' ').trim())})"
 },
 {
  "assert": "document.querySelectorAll('.tree > li').length===1 && document.querySelectorAll('.tree li ul li').length>=3"
 },
 {
  "assert": "(()=>{const r=document.querySelector('.line[role=dialog]').getBoundingClientRect();return r.left>=0&&r.right<=innerWidth})()"
 },
 {
  "shot": "n3-h-line"
 },
 {
  "click": "button:has-text('Back to the map')"
 },
 {
  "eval": "(()=>{const c=window.__clade;c.world.lineages.find(l=>l.id==='worm-line').xp=130;c.setMode('habitats');return true})()"
 },
 {
  "eval": "window.__clade.openLine()"
 },
 {
  "wait": 300
 },
 {
  "assert": "document.querySelector('.line[role=dialog]').textContent.includes('1 point to spend')"
 },
 {
  "click": ".part:has-text('Burrowing bulb') button"
 },
 {
  "wait": 200
 },
 {
  "assert": "window.__clade.world.lineages.find(l=>l.id==='worm-line').ranks.bulb===1 && [...document.querySelectorAll('.part button')].every(b=>b.disabled) && [...document.querySelectorAll('.part')].some(p=>p.textContent.includes('Burrowing bulb · rank 1/3'))"
 },
 {
  "shot": "n3-h-spent"
 }
]