[
  {"until": "!!window.__clade"},
  {"eval": "(()=>{const c=window.__clade;c.setPreset('first-worm');c.pick('root-worm');const t=c.world.habitats.find(h=>{c.select(h.id);return c.colonise()});return {launched:!!t}})()"},
  {"until": "!!window.__game && !window.__game.busy"},
  {"click": "button:has-text('+10 food')"},
  {"until": "!window.__game.busy"},
  {"click": "#grow"},
  {"until": "!window.__game.busy"},
  {"click": "#wait"},
  {"until": "!window.__game.busy"},
  {"assert": "!document.querySelector('.mutation')"},
  {"click": "#grow"},
  {"until": "!window.__game.busy && !!document.querySelector('.mutation')"},
  {"assert": "window.__game.life.size===3 && document.querySelectorAll('.mutation .card').length===window.__game.life.mutationOffer.length && window.__game.life.mutationOffer.length>0"},
  {"assert": "document.querySelector('#wait').disabled && document.querySelector('#lay').disabled && window.__game.destinations.length>0"},
  {"assert": "(()=>{const r=document.querySelector('.mutation').getBoundingClientRect(),s=document.querySelector('#stage').getBoundingClientRect();return r.top>=s.top&&r.bottom<=s.bottom&&r.left>=0&&r.right<=innerWidth})()"},
  {"eval": "({offer:window.__game.life.mutationOffer, turn:window.__game.life.turn})"},
  {"wait": 300},
  {"shot": "n3-f-offer"},
  {"eval": "window.__f={turn:window.__game.life.turn,part:window.__game.life.mutationOffer[0]}"},
  {"click": ".mutation .card >> nth=0"},
  {"until": "!window.__game.busy && !document.querySelector('.mutation')"},
  {"assert": "window.__game.life.mutation.part===window.__f.part && window.__game.life.turn===window.__f.turn && document.querySelector('#mutant').textContent.includes('Mutation:') && !document.querySelector('#wait').disabled"},
  {"wait": 500},
  {"shot": "n3-f-picked"}
]
