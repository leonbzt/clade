[
  {"until": "!!window.__clade"},
  {"eval": "(async()=>{const c=window.__clade;c.setPreset('first-worm');const {colonise}=await import('/clade/src/sim/found.ts');const parent=c.world.species.find(s=>s.id==='root-worm');const target=c.world.habitats.find(h=>colonise(c.world,h,parent));c.pick(parent.id);c.select(target.id);return {launched:c.colonise()}})()"},
  {"until": "!!window.__game && !window.__game.busy"},
  {"assert": "window.__game.life.mutationOffer===null"},
  {"click": "button:has-text('+10 food')"},
  {"until": "!window.__game.busy"},
  {"click": "#grow"},
  {"until": "!window.__game.busy"},
  {"assert": "window.__game.life.size===2 && window.__game.life.mutationOffer===null"},
  {"click": "#wait"},
  {"until": "!window.__game.busy"},
  {"click": "#grow"},
  {"until": "!window.__game.busy"},
  {"eval": "(async()=>{const g=window.__game,l=g.life;const {PARTS}=await import('/clade/src/data/parts.ts');const {newLife}=await import('/clade/src/sim/life.ts');const {offerMutation}=await import('/clade/src/sim/mutation.ts');const probe=newLife(l.board,{clade:'worm',parts:{},genes:{size:1,gut:1}},{},l.seed);probe.size=3;offerMutation(probe);const part=l.mutationOffer.find(p=>PARTS[p].upkeep>0)??l.mutationOffer[0];window.__n3b={offer:[...l.mutationOffer],repeat:JSON.stringify(l.mutationOffer)===JSON.stringify(probe.mutationOffer),turn:l.turn,food:l.food,part,upkeep:1+PARTS[part].upkeep};await g.mutate(part);return window.__n3b})()"},
  {"assert": "window.__n3b.offer.length===3 && new Set(window.__n3b.offer).size===3 && window.__n3b.repeat"},
  {"assert": "window.__game.life.turn===window.__n3b.turn && window.__game.life.food===window.__n3b.food && window.__game.life.mutation.part===window.__n3b.part && window.__game.life.mutationOffer.length===0"},
  {"assert": "document.querySelector('#body').textContent.includes('upkeep '+window.__n3b.upkeep)"},
  {"shot": "n3-b-mutation"},
  {"click": "#lay"},
  {"until": "!window.__game.busy"},
  {"assert": "window.__game.life.eggs>0 && window.__game.life.eggsAfter===window.__game.life.eggs"},
  {"click": "button:has-text('End the season')"},
  {"until": "!!window.__clade.session.report"},
  {"eval": "(async()=>{const {resultOf}=await import('/clade/src/sim/economy.ts');return resultOf(window.__game.life)})()"},
  {"click": "button:has-text('Back to the map')"},
  {"until": "!window.__game"},
  {"assert": "Object.keys(window.__clade.world.species.find(s=>s.id==='root-worm').build.parts).length===0"}
]
