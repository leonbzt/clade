  {"eval": "(async()=>{\n  const g=window.__game, route=window.__n2.route, order=[\"tentacles\", \"pouch\", \"sclerite\"];\n  for(let i=0;i<100&&g.life.phase==='play';i++){\n    const a=route.choose(g.life,order); window.__n2.turns.push({turn:g.life.turn,food:g.life.food,health:g.life.health,...a});\n    if(a.kind==='enforce')await g.enforce(a.part);\n    else if(a.kind==='verb')await g.verb(a.verb);\n    else if(a.kind==='move')await g.move(a.tile);\n    else await g[a.kind]();\n    if(g.life.size>=3&&g.life.turn<10)break;\n  }\n})()"},
  {"wait": 100},
