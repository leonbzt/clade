[
  {"until": "!!window.__clade"},
  {"eval": "(async()=>{const c=window.__clade;c.setPreset('midgame');const {colonise}=await import('/clade/src/sim/found.ts');for(const s of c.world.species.filter(s=>s.lineage==='worm-line')){const t=c.world.habitats.find(h=>colonise(c.world,h,s));if(t){c.select(t.id);return {sent:c.send(s.id),who:s.name,to:t.name}}}return 'none'})()"},
  {"until": "!!window.__game && !window.__game.busy"},
  {"click": "button:has-text('+10 food')"},
  {"until": "!window.__game.busy"},
  {"click": "#grow"},
  {"until": "!window.__game.busy"},
  {"click": "#wait"},
  {"until": "!window.__game.busy"},
  {"click": "#grow"},
  {"until": "!window.__game.busy"},
  {"eval": "window.__game.life.mutationOffer && window.__game.mutate(window.__game.life.mutationOffer[0])"},
  {"until": "!window.__game.busy"},
  {"click": "#lay"},
  {"until": "!window.__game.busy"},
  {"click": "button:has-text('End the season')"},
  {"until": "!!window.__clade.clutch"},
  {"wait": 600},
  {"eval": "window.__clade.hatch(0)"},
  {"wait": 600},
  {"click": "button:has-text('Back to the map')"},
  {"until": "!window.__game"},
  {"assert": "window.__clade.replaying"},
  {"wait": 1800},
  {"shot": "n4-g-replay"},
  {"until": "!window.__clade.replaying"},
  {"wait": 300},
  {"assert": "window.__clade.notesOpen && document.querySelectorAll('.notes .line, .notes .quiet').length>0"},
  {"eval": "window.__clade.news"},
  {"shot": "n4-g-notes"},
  {"click": ".notes .close"},
  {"wait": 200},
  {"click": "button.notes"},
  {"wait": 200},
  {"assert": "window.__clade.notesOpen"}
]
