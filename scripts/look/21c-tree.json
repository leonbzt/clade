[
  {"init":"Math.random = () => 1 / 2 ** 31;"},
  {"click":".treeButton"},
  {"until":"document.querySelectorAll('.tree canvas').length === 4"},
  {"assert":"document.querySelectorAll('.tree .node').length === 4 && document.querySelectorAll('.tree .locked').length === 3"},
  {"assert":"document.querySelectorAll('.root > .branch[data-lineage=worm] > .children > .branch[data-lineage=arthropod] > .children > .branch').length === 2"},
  {"assert":"[...document.querySelectorAll('.tree, .node, .treeWrap')].every(e => e.scrollWidth <= e.clientWidth) && document.documentElement.scrollWidth === innerWidth"},
  {"shot":"21c-tree-fresh"},
  {"click":".tree .branch[data-lineage=worm] > .node .nodeButton"},
  {"until":"!!document.querySelector('.lineView canvas')"},
  {"assert":"document.querySelector('.lineView .metaTop button').textContent === 'Tree of life' && !document.querySelector('.tree')"},
  {"assert":"document.querySelector('.lineView').scrollWidth <= document.querySelector('.lineView').clientWidth"},
  {"click":".lineView .metaTop button"},
  {"click":".tree .metaTop button"},
  {"click":"#meta button:has-text('Dev')"},
  {"click":"#dev button:has-text('Open all lineages')"},
  {"click":"#devClose"},
  {"eval":"(async () => { const { settleLine } = await import('/game/src/sim/lineage.ts'); const { defaultBuild } = await import('/game/src/sim/body.ts'); for (let k = 1; k <= 4; k++) settleLine(__game.save.lines, 'worm', 3, 'F', defaultBuild('worm'), null, k); })()"},
  {"click":".treeButton"},
  {"until":"document.querySelectorAll('.tree canvas').length === 4"},
  {"assert":"document.querySelectorAll('.tree .locked').length === 0 && document.querySelectorAll('.tree .nodeButton:not(:disabled)').length === 4"},
  {"assert":"[...document.querySelectorAll('.tree .branch[data-lineage=worm] > .node .species li')].map(e => e.textContent).join(',') === 'Worm 4,Worm 3,Worm 2' && document.querySelector('.tree .more').textContent === '+1 species'"},
  {"assert":"[...document.querySelectorAll('.tree, .node, .treeWrap')].every(e => e.scrollWidth <= e.clientWidth) && document.documentElement.scrollWidth === innerWidth"},
  {"shot":"21c-tree-open"},
  {"eval":"document.querySelector('.tree').scrollTop = document.querySelector('.tree').scrollHeight;"},
  {"shot":"21c-tree-branches"},
  {"click":".tree .branch[data-lineage=swimmer] > .node .nodeButton"},
  {"until":"!!document.querySelector('.lineView canvas')"},
  {"assert":"document.querySelector('.lineView h2').textContent === 'Swimmer line'"},
  {"assert":"document.querySelector('.lineView').scrollWidth <= document.querySelector('.lineView').clientWidth"},
  {"click":".lineView .metaTop button"},
  {"click":".tree .metaTop button"},
  {"assert":"!document.querySelector('.tree') && !document.querySelector('.lineView') && !document.querySelector('#meta').hidden"}
]
