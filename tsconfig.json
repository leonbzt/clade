{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["vite/client", "vitest/config", "node"]
  },
  "include": ["src/**/*.ts", "toys/**/*.ts", "src/**/*.svelte", "tests/**/*.ts", "spikes/pixi-life/**/*.ts", "vite.config.ts"]
}
